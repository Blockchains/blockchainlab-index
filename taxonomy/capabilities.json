{
 "version": "2026-10-03",
 "description": "Blockchain Lab capability taxonomy. Maps plain-language ideas to required capabilities, and capabilities to components in the Blockchains fork index. 'match' rules are applied to indexed components (name/base/function/path); 'synonyms' drive idea parsing; 'preferred' lists default components as <slug>:<path>.",
 "vm_preference": [
  "EVM",
  "Hedera",
  "SVM",
  "Move",
  "Cosmos",
  "Substrate",
  "Bitcoin",
  "ZK"
 ],
 "license_policy": {
  "permissive": [
   "MIT",
   "Apache-2.0",
   "BSD-2-Clause",
   "BSD-3-Clause",
   "ISC",
   "Unlicense",
   "0BSD",
   "MIT OR Apache-2.0"
  ],
  "weak_copyleft": [
   "LGPL-2.1",
   "LGPL-3.0",
   "MPL-2.0"
  ],
  "strong_copyleft": [
   "GPL-2.0",
   "GPL-2.0-or-later",
   "GPL-3.0",
   "AGPL-3.0"
  ],
  "source_available_blocked": [
   "BUSL-1.1",
   "LicenseRef-*",
   "UNLICENSED"
  ],
  "rules": [
   "Prefer permissive components when two candidates score within 10%.",
   "Copying any GPL-3.0/AGPL-3.0 file makes the whole generated repo GPL-3.0/AGPL-3.0: warn and set LICENSE accordingly.",
   "LGPL files may be linked/imported unmodified; keep their headers and ship LGPL text in NOTICE.",
   "Never copy BUSL-1.1 or non-OSI files; reference them only as external dependencies with a warning.",
   "Always keep SPDX headers and add a NOTICE entry per source repo + commit."
  ]
 },
